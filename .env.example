# Frontend build-time setting. Keep false for production to avoid showing demo inventory.
VITE_DEMO_MODE=false

# Required by the Node.js server in production; configure privately in the hosting panel.
NODE_ENV=production
PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=https://haatbazar1.kesug.com
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Use actual registered business details; do not invent or use placeholders in production.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
SUPPORT_EMAIL=
TRADE_LICENSE_NO=

# SSLCommerz: leave blank until sandbox/live merchant credentials are supplied.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false

# WhatsApp click-to-chat support number in international digits, without + or spaces (example format: 8801XXXXXXXXX).
# Leave blank to hide the floating support button until the real support number is confirmed.
VITE_WHATSAPP_NUMBER=

# SMS HTTP adapter; confirm the provider's exact API contract and sender approval.
SMS_API_URL=
SMS_API_KEY=

# Courier adapter; confirm endpoint/payload against the chosen courier account.
COURIER_API_URL=
COURIER_API_KEY=
COURIER_API_SECRET=
COURIER_PROVIDER=
COURIER_DELIVERY_TYPE=0
