Options -Indexes
DirectoryIndex index.html index.php

# Send the account URLs to the PHP backend on InfinityFree.
RewriteEngine On
RewriteRule ^api/login/?$ api/index.php?action=login [QSA,L]
RewriteRule ^api/register/?$ api/index.php?action=register [QSA,L]
RewriteRule ^api/account/?$ api/index.php?action=account [QSA,L]
RewriteRule ^api/logout/?$ api/index.php?action=logout [QSA,L]
RewriteRule ^api/me/?$ api/index.php?action=me [QSA,L]
RewriteRule ^api/csrf/?$ api/index.php?action=csrf [QSA,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^api/listings/?$ api/index.php?action=products [QSA,L]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^api/listings/?$ api/index.php?action=create_listing [QSA,L]
RewriteRule ^api/listings/([^/]+)/?$ api/index.php?action=listing&id=$1 [QSA,L]
RewriteRule ^api/orders/?$ api/index.php?action=orders [QSA,L]
RewriteRule ^api/admin/orders/?$ api/index.php?action=admin_orders [QSA,L]
RewriteRule ^api/admin/products/?$ api/index.php?action=admin_products [QSA,L]
RewriteRule ^api/admin/product-update/?$ api/index.php?action=admin_product_update [QSA,L]
RewriteRule ^api/admin/product-delete/?$ api/index.php?action=admin_product_delete [QSA,L]
RewriteRule ^api/admin/order-status/?$ api/index.php?action=admin_order_status [QSA,L]
RewriteRule ^api/admin/ship-order/?$ api/index.php?action=admin_ship_order [QSA,L]
RewriteRule ^api/seller/orders/?$ api/index.php?action=seller_orders [QSA,L]

# Do not serve the React app for unknown API routes.
RewriteRule ^api/ - [L]

# React client-side routes (district/category/detail pages) need index.html fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Keep configuration and SQL files private.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.env|.*\.log|.*\.sqlite|.*\.db)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
